# Copia este archivo a .env.local para desarrollo, y súbelo a Vercel con
# `vercel env add` o desde Settings → Environment Variables.
#
# Todo es opcional: sin nada configurado el formulario funciona y cada
# postulación queda registrada en los logs de Vercel. Configura al menos
# LEAD_WEBHOOK_URL para tener la tabla comparativa de canales.

# ── Destino de las postulaciones ──────────────────────────────
# Recibe un POST con JSON. Sirve un webhook de n8n, Make, Zapier
# o un Google Apps Script publicado como app web (ver README).
# Llegan dos eventos: "completado" y "progreso".
LEAD_WEBHOOK_URL=

# ── Grupo de WhatsApp ─────────────────────────────────────────
# Enlace de invitación (chat.whatsapp.com/...). Al terminar, la
# persona ve el botón y se la redirige sola a los 6 segundos.
# Si se deja vacío, no aparece el botón: nunca un enlace roto.
# OJO: se inyecta al compilar. Después de cambiarlo hay que volver
# a desplegar para que tome efecto.
NEXT_PUBLIC_WHATSAPP_GRUPO=

# ── Aviso por correo (opcional) ───────────────────────────────
# Crea la clave en https://resend.com
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=Constelarys <onboarding@resend.dev>
