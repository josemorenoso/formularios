      "id": "switch-evento",
      "name": "¿Completado o progreso?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Una fila por postulación, con los nombres de columna ya puestos.\n// El nodo de Sheets mapea automáticamente por nombre, así que estas\n// claves deben coincidir con los encabezados de la hoja.\nconst d = $input.first().json.body;\nconst r = d.respuestas || {};\n\nreturn [{\n  json: {\n    'Fecha': d.recibido,\n    'Canal': d.canalLegible,\n    'Detección': d.deteccion,\n    'Campaña': d.campana || '',\n    'ManyChat ID': d.manychatId || '',\n    'Visita': d.visita || '',\n    'Nombre': d.nombre,\n    'WhatsApp': d.whatsapp,\n    'Empresa y cargo': d.empresaCargo,\n    'Trabajadores': r['Cantidad de trabajadores'] || '',\n    'Qué vende': r['¿Qué vende tu empresa y cómo te llegan hoy los clientes?'] || '',\n    'Proceso costoso': r['¿Cuál es el proceso que más tiempo o plata te está costando hoy?'] || '',\n    'Intentos previos': r['¿Has intentado resolverlo antes? ¿Con qué?'] || '',\n    'Costo mensual': d.costoMensualPesos || '',\n    'Por qué él': r['¿Por qué deberías ganártelo tú?'] || '',\n    'Quién decide': r['¿La decisión de contratar algo así la tomas tú solo o hay alguien más?'] || '',\n    'Plazo': r['¿Para cuándo necesitas esto resuelto?'] || ''\n  }\n}];"
      },
      "id": "code-postulacion",
      "name": "Armar fila de postulación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 180]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REEMPLAZA_CON_EL_ID_DE_TU_HOJA",
          "mode": "id"
        },
