        },
        "options": {}
      },
      "id": "sheets-postulaciones",
      "name": "Hoja · Postulaciones",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 180],
      "notes": "Vuelve a elegir el documento y la pestaña desde el selector después de importar."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "tiene-manychat",
              "leftValue": "={{ $('Formulario').item.json.body.manychatId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-manychat",
      "name": "¿Vino de ManyChat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.manychat.com/fb/subscriber/addTagByName",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subscriber_id: $('Formulario').item.json.body.manychatId, tag_name: 'postulacion-completada' }) }}",
        "options": {}
      },
      "id": "manychat-etiqueta",
      "name": "ManyChat · marcar completado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 180],
      "notes": "Credencial Header Auth: Name = Authorization, Value = Bearer TU_TOKEN_MANYCHAT. Esta etiqueta es la que apaga el recordatorio en el flujo de ManyChat."
    },
    {
      "parameters": {
        "jsCode": "// Una fila por avance. Sirve para dos cosas: saber en qué pregunta se\n// cae la gente, y tener a quién recuperar si nunca llegó el completado.\nconst d = $input.first().json.body;\n\nreturn [{\n  json: {\n    'Fecha': d.actualizado,\n    'Visita': d.visita,\n    'Canal': d.canalLegible,\n    'ManyChat ID': d.manychatId || '',\n    'Campaña': d.campana || '',\n    'Respondidas': d.respondidas,\n    'Total': d.total,\n    'Se quedó en': d.ultimaPregunta,\n    'Nombre': d.nombre || '',\n    'WhatsApp': d.whatsapp || '',\n    'Empresa y cargo': d.empresaCargo || ''\n  }\n}];"
      },
      "id": "code-progreso",
      "name": "Armar fila de progreso",
